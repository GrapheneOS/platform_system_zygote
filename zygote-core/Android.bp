package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_system_performance",
}

rust_library {
    name: "libzygote_core",
    crate_name: "zygote_core",
    defaults: ["zygote_defaults"],
    srcs: [
        "src/lib.rs",
    ],
    rustlibs: [
        "liblog_rust",
        "liblogger",
        "libthiserror",
        "libtracing",
        "libtracing_subscriber",
    ],
    target: {
        android: {
            rustlibs: [
                "libatrace_rust",
                "libatrace_tracing_subscriber",
            ],
        },
        host: {
            rustlibs: [
                "libtracing_subscriber",
            ],
        },
    },
}
