package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

genrule {
    name: "libzygote_schemas-rust",
    tools: ["flatc"],
    cmd: "$(location flatc) --rust --filename-suffix '' -o $$(dirname $(out)) $(in)",
    srcs: [
        "schemas/messages.fbs",
    ],
    out: [
        "src/messages.rs",
    ],
}

genrule {
    name: "libzygote_schemas-cpp",
    tools: ["flatc"],
    cmd: "mkdir -p $(genDir)/libzygote_schemas && $(location flatc) --cpp --filename-suffix '' -o $(genDir)/libzygote_schemas $(in)",
    srcs: [
        "schemas/messages.fbs",
    ],
    out: [
        "libzygote_schemas/messages.h",
    ],
    export_include_dirs: [
        ".",
    ],
}

cc_library_headers {
    name: "libzygote_schema_headers",
    host_supported: true,
    generated_headers: ["libzygote_schemas-cpp"],
    export_generated_headers: ["libzygote_schemas-cpp"],
    header_libs: [
        "flatbuffer_headers",
    ],
}

rust_library {
    name: "libzygote",
    crate_name: "zygote",
    host_supported: true,
    edition: "2021",
    srcs: [
        "src/lib.rs",
        ":libzygote_schemas-rust",
    ],
    rustlibs: [
        "libanyhow",
        "libarrayvec",
        "libcapwrap",
        "libclap",
        "libflatbuffers",
        "libitertools",
        "liblibc",
        "liblibloading",
        "liblogger",
        "liblog_rust",
        "libstatic_assertions",
        "libzerocopy",
        "libzygote_sys",
    ],
}

rust_library {
    name: "libzygote_test",
    crate_name: "zygote",
    host_supported: true,
    edition: "2021",
    features: [
        "test",
    ],
    srcs: [
        "src/lib.rs",
        ":libzygote_schemas-rust",
    ],
    rustlibs: [
        "libanyhow",
        "libarrayvec",
        "libcapwrap",
        "libclap",
        "libflatbuffers",
        "libitertools",
        "liblibc",
        "liblibloading",
        "liblogger",
        "liblog_rust",
        "libstatic_assertions",
        "libzerocopy",
        "libzygote_sys",
    ],
}

rust_binary {
    name: "zygote_next",
    host_supported: true,
    edition: "2021",
    srcs: [
        "src/bin/zygote.rs",
    ],
    rustlibs: [
        "libanyhow",
        "libclap",
        "liblogger",
        "liblog_rust",
        "libzygote",
        "libzygote_sys",
    ],
}

rust_binary {
    name: "zygote_cli",
    host_supported: true,
    edition: "2021",
    srcs: [
        "src/bin/zygote_cli.rs",
    ],
    rustlibs: [
        "libanyhow",
        "libclap",
        "libflatbuffers",
        "liblibc",
        "liblibloading",
        "liblogger",
        "liblog_rust",
        "libzygote",
        "libzygote_sys",
    ],
}

rust_binary {
    name: "zygote_launch",
    host_supported: true,
    edition: "2021",
    srcs: [
        "src/bin/zygote_launch.rs",
    ],
    rustlibs: [
        "libanyhow",
        "libclap",
        "libflatbuffers",
        "liblibc",
        "liblibloading",
        "liblogger",
        "liblog_rust",
        "libzygote",
        "libzygote_sys",
    ],
}

rust_test_host {
    name: "zygote_next_unit_tests",
    edition: "2021",
    features: [
        "test",
    ],
    srcs: [
        "src/lib.rs",
        ":libzygote_schemas-rust",
    ],
    rustlibs: [
        "libanyhow",
        "libarrayvec",
        "libcapwrap",
        "libclap",
        "libflatbuffers",
        "libitertools",
        "liblibc",
        "liblibloading",
        "liblogger",
        "liblog_rust",
        "libstatic_assertions",
        "libzygote_sys",
        "libzerocopy",
        "libzygote_sys",
    ],
}

rust_test_host {
    name: "zygote_next_integration_test_fd_no_panic",
    edition: "2021",
    test_harness: false,
    cfgs: [
        "test",
    ],
    features: [
        "test",
    ],
    srcs: [
        "tests/file_descriptors/calm.rs",
    ],
    rustlibs: [
        "librustix",
        "liblibc",
        "liblibtest_mimic",
        "libzygote_sys",
        "libzygote_test",
    ],
}
