service zygote_next /system/bin/zygote_next --name zygote_next --species android-native-app --log-level INFO --arg-buf-padding xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    user root
    group root
    priority -20
    socket zygote_next seqpacket 660 root system
    disabled
    onrestart setprop zygote.zygote_next.server_ready false
