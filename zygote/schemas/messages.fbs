// Zygote management commands

table Exit {}

table SpawnAndroidNative {
    package: string (required);
}

table SpawnMock {
    name: string (required);
}

table SpawnLibApp {
    path: string (required);
}

table Stat {}

union Command {
    Exit,
    SpawnAndroidNative,
    SpawnLibApp,
    SpawnMock,
    Stat,
}

table Message {
    command: Command;
}

root_type Message;