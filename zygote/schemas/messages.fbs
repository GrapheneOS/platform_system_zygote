// Zygote management commands

table Exit {}

table SpawnAndroidNative {
    package: string (required);
}

table SpawnMock {
    name: string (required);
}

table SpawnLibApp {
    path: string (required);
    args: [string] (required);
}

table Stat {}

union Message {
    Exit,
    SpawnAndroidNative,
    SpawnLibApp,
    SpawnMock,
    Stat,
}

table Parcel {
    message: Message;
}

root_type Parcel;