rust_library {
    name: "libzygote_sys",
    crate_name: "zygote_sys",
    defaults: ["zygote_defaults"],
    srcs: [
        "src/lib.rs",
    ],
    rustlibs: [
        "libanyhow",
        "libarrayvec",
        "liblibc",
        "libstatic_assertions",
        "libzerocopy",
    ],
    target: {
        android: {
            rustlibs: [
                "libprocessgroup_rust",
                "libselinux_bindgen",
            ],
            shared_libs: [
                "libdl_android",
                "libprocessgroup",
                "libselinux",
            ],
        },
    },
}
