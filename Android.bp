package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "zygote_defaults",
    host_supported: true,
    edition: "2024",
}

phony {
    name: "zygote_all",
    required: [
        "libmemmark",
        "libzygote",
        "libzygote_core",
        "libzygote_sys",
        "libzygote_messages",
        "libzygote_test",
        "zygote_cli",
        "zygote_launch",
        "zygote_next",
        "zygote_next_unit_tests",
        "zygote_next_integration_test_fd_no_panic",
    ],
}
